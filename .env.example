# AI 管家 Agent 生态体系 —— 【dev】环境配置（唯一来源）
# 计划书依据：三、P0-1「搭建四环境隔离体系：开发、测试、预发布、生产完全独立隔离」
# 本文件同时供 docker compose（--env-file）与应用（AIBUTLER_ENV）使用。
# 隔离口径见 ai_butler/core/environments.py；四环境资源两两不相交。

# ---------- compose 参数 ----------
COMPOSE_PROJECT_NAME=
CONTAINER_PREFIX=
DATA_ROOT=
ENV_FILE_NAME=
DATA_PLANE_INTERNAL=
POSTGRES_IMAGE=
REDIS_IMAGE=
API_IMAGE=
POSTGRES_PORT=
REDIS_PORT=
API_PORT=
# 资源限制（计划书三、P0-1「统一 Dockerfile、资源限制、启动模板」）
PG_CPUS=
PG_MEMORY=
REDIS_CPUS=
REDIS_MEMORY=
API_CPUS=
API_MEMORY=

# ---------- 应用参数 ----------
ENVIRONMENT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
REDIS_HOST=
REDIS_DB=
SESSION_TOKEN_SECRET=
SESSION_TTL_SECONDS=
SESSION_IDLE_TIMEOUT_SECONDS=
SESSION_REFRESH_AHEAD_SECONDS=
FIELD_ENCRYPTION_KEY=
WIKI_ROOT=
STORAGE_ROOT=

# ---------- 统一 LLM 网关 ----------
LLM_PROVIDER_ORDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
DEEPSEEK_MODEL=
DASHSCOPE_MODEL=
DEEPSEEK_API_KEY=

# ---------- 语音（U65：VAD 端侧随包，ASR/TTS 走云端）----------
# 模型用 scripts/download_speech_models.py 落地到 speech_models_root。
SPEECH_MODELS_ROOT=
SPEECH_ENABLE=
SPEECH_MAX_AUDIO_SECONDS=
SPEECH_TTS_SPEAKER=
SPEECH_TTS_SPEED=
SPEECH_NUM_THREADS=
# U63 声纹：阈值偏严，取不到分数一律判不匹配
VOICEPRINT_THRESHOLD=
VOICEPRINT_MAX_SAMPLES=

# ---------- 访客层（U64：未登录只能文字查询）----------
# 访客走同一套 SessionAuthMiddleware，不是免鉴权白名单。
GUEST_ENABLE=
GUEST_SESSION_TTL_SECONDS=
GUEST_TEXT_QUERY_BUDGET=
GUEST_PUBLIC_SCOPE=

# ---------- 检索与问答 ----------
# reranker 默认关（bge-reranker-base 约 1GB），关时 reranked 如实报 False
SEARCH_RERANKER_ENABLE=
CHAT_VERIFY_ENABLE=
CHAT_TOP_K=

# ---------- 账号体系（U67 / U68 / U69）----------
# 空则跟 storage_root 走；独立配置是为了让隐私数据能单独挂卷、单独备份与销毁
ACCOUNT_STORE_ROOT=
# 重置令牌投递通道：dev（响应回显，仅本机联调）/ console（只打日志）/ smtp（真投递）
# **production 只允许 smtp**，其余在启动时直接拒绝 —— 允许 dev 进生产等于谁都能改密
RESET_CHANNEL=

# ---------- 重置令牌的邮件通道（U72）----------
# 只对**邮箱注册**的账号可用；手机号账号没有收件地址，通道会如实记一条 skip
# 465 用 SMTP_SSL=true（多数邮箱的默认）；587 用 SMTP_SSL=false 走 STARTTLS
# 缺 SMTP_HOST / SMTP_PORT / SMTP_SENDER 三键时启动即拒，并报出缺的是哪个
SMTP_HOST=
SMTP_PORT=
SMTP_SENDER=
# 服务商给的登录名/授权码（QQ、163 等用的是「授权码」而不是登录密码）
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=

# ---------- 模型接入（U70）----------
# 免费/限免额度按**账号**计量，默认路径（未选过模型）同样扣
MODEL_FREE_DAILY_CALLS=
MODEL_TRIAL_DAILY_CALLS=

# ---------- 定位与推荐（U71）----------
# 粗化位数：按位截断（非四舍五入），3 位小数 ≈ 110 m
GEO_GRID_DECIMALS=
GEO_RECOMMEND_LIMIT=
